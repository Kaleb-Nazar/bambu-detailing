# Dependencies (pnpm downloads them again with `pnpm install`)
node_modules/

# Build output (generated from the source code, never edited by hand)
dist/
build/
.react-router/
coverage/

# Turborepo cache
.turbo/

# Private planning notes (public docs like ADRs live in the rest of docs/)
docs/internal/
docs/aprendizaje/

# Environment variables: only the example file is committed
.env
.env.*
!.env.example

# Logs
*.log

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

